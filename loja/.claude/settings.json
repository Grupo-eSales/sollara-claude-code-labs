{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run typecheck)",
      "Bash(npm run dev)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "PowerShell(npm test)",
      "PowerShell(npm run typecheck)",
      "PowerShell(npm run dev)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(npm install *)",
      "PowerShell(git push *)",
      "PowerShell(npm install *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/bloquear-comandos.mjs"]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/typecheck-apos-editar.mjs"]
          }
        ]
      }
    ]
  }
}
